#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use AnyLint\Analyzer;
use AnyLint\Baseline;
use AnyLint\Config;
use AnyLint\Finding;
use AnyLint\Fixer;
use AnyLint\ParallelRunner;
use AnyLint\ResultCache;
use AnyLint\Formatters\CheckstyleFormatter;
use AnyLint\Formatters\SarifFormatter;
use AnyLint\Report\HtmlReport;
use AnyLint\Report\ProjectReport;
use AnyLint\Report\TextReport;
use AnyLint\Providers\CProvider;
use AnyLint\Providers\CppProvider;
use AnyLint\Providers\CSharpProvider;
use AnyLint\Providers\DartProvider;
use AnyLint\Providers\GoProvider;
use AnyLint\Providers\JavaProvider;
use AnyLint\Providers\JavaScriptProvider;
use AnyLint\Providers\KotlinProvider;
use AnyLint\Providers\LuaProvider;
use AnyLint\Providers\NyxilumProvider;
use AnyLint\Providers\ObjectiveCProvider;
use AnyLint\Providers\PhpProvider;
use AnyLint\Providers\PythonProvider;
use AnyLint\Providers\RubyProvider;
use AnyLint\Providers\RustProvider;
use AnyLint\Providers\SolidityProvider;
use AnyLint\Providers\SwiftProvider;
use AnyLint\Providers\TypeScriptProvider;
use AnyLint\Providers\ZigProvider;
use AnyLint\Rules\ComplexFunctionRule;
use AnyLint\Rules\DeadCodeAfterReturnRule;
use AnyLint\Rules\DuplicateCodeRule;
use AnyLint\Rules\DeepNestingRule;
use AnyLint\Rules\EmptyBlockRule;
use AnyLint\Rules\EmptyCatchRule;
use AnyLint\Rules\EmptyFunctionRule;
use AnyLint\Rules\HardcodedSecretRule;
use AnyLint\Rules\LongFunctionRule;
use AnyLint\Rules\PromotableReturnTypeRule;
use AnyLint\Rules\TodoTrackerRule;
use AnyLint\Rules\UnusedVariableRule;
use AnyLint\Rules\WindowsScriptEncodingRule;
use AnyLint\Severity;

$args = array_slice($argv, 1);
// "anylint report <шлях>" - зведення стану проєкту замість списку знахідок.
$report = ($args[0] ?? null) === 'report';
if ($report) {
    array_shift($args);
}

if (in_array('--help', $args, true) || $args === []) {
    echo "anylint <шлях> [--json|--checkstyle|--sarif] [--fix] [--no-todo] [--jobs <N>] [--no-cache]\n";
    echo "        [--config <файл>] [--no-config] [--baseline <файл>] [--generate-baseline]\n";
    echo "anylint report <шлях> [--format text|json|html] [--output <файл>] [--no-todo] [--jobs <N>]\n";
    echo "        [--no-cache] [--config <файл>] [--no-config]\n";
    echo "  Кросплатформний статичний аналізатор з архітектурою плагінів під мови.\n";
    echo "  Мови: PHP, NyxilumLang, JavaScript, TypeScript, C, C++, C#, Java, Python, Rust, Swift, Go,\n";
    echo "        Kotlin, Lua, Ruby, Dart, Zig, Objective-C, Solidity.\n";
    echo "  --checkstyle: вивід у форматі Checkstyle XML (File Watcher у PhpStorm та інших IDE\n";
    echo "                вміє імпортувати цей формат нативно, без окремого плагіна).\n";
    echo "  --sarif:      SARIF 2.1.0 (GitHub Code Scanning, GitLab, Azure DevOps).\n";
    echo "  --fix:        застосувати автовиправлення, далі показати те, що лишилось.\n";
    echo "  --config <файл>: явний конфіг; без нього шукається anylint.json або\n";
    echo "                .anylint.json від теки шляху вгору. --no-config - не шукати.\n";
    echo "  --baseline <файл>: не показувати знахідки, прийняті в цьому файлі\n";
    echo "                (або \"baseline\" у конфігу).\n";
    echo "  --generate-baseline: записати всі поточні знахідки в baseline і вийти з 0.\n";
    echo "  --jobs <N|auto>: скільки процесів аналізують паралельно (типово 1; auto -\n";
    echo "                кількість ядер; без розширення pcntl завжди послідовно).\n";
    echo "  --no-cache:   не використовувати кеш результатів (типово незмінені файли не\n";
    echo "                розбираються вдруге; кеш - у системній тимчасовій теці).\n";
    echo "\n";
    echo "  report:       зведення стану проєкту: мови й рядки коду, знахідки за правилами й\n";
    echo "                серйозністю, найскладніші функції, гарячі файли, частка дублювання.\n";
    echo "                Baseline не застосовується - звіт показує весь борг, разом із прийнятим.\n";
    echo "  --format:     text (типово), json або html (самодостатній файл, світла/темна тема).\n";
    echo "  --output <файл>: записати звіт у файл замість stdout.\n";
    exit(0);
}

$json = in_array('--json', $args, true);
$checkstyle = in_array('--checkstyle', $args, true);
$sarif = in_array('--sarif', $args, true);
$fix = in_array('--fix', $args, true);
$noTodo = in_array('--no-todo', $args, true);
$noConfig = in_array('--no-config', $args, true);
$generateBaseline = in_array('--generate-baseline', $args, true);
$noCache = in_array('--no-cache', $args, true);

/** @var array<string, string|null> $values опції зі значенням: --name <v> або --name=<v> */
$values = ['--config' => null, '--baseline' => null, '--jobs' => null, '--format' => null, '--output' => null];
$path = null;
for ($i = 0; $i < count($args); $i++) {
    $arg = $args[$i];
    if (array_key_exists($arg, $values)) {
        $value = $args[++$i] ?? null;
        if ($value === null) {
            fwrite(STDERR, "{$arg} потребує значення.\n");
            exit(2);
        }
        $values[$arg] = $value;
        continue;
    }
    foreach (array_keys($values) as $name) {
        if (str_starts_with($arg, $name . '=')) {
            $values[$name] = substr($arg, strlen($name) + 1);
            continue 2;
        }
    }
    if ($path === null && !str_starts_with($arg, '--')) {
        $path = $arg;
    }
}
$configFile = $values['--config'];
// Типово послідовно: на 2-ядерній машині під навантаженням кожен додатковий
// процес лише платить ще раз за старт node (~0.6 с на require('typescript'))
// і прогін стає ПОВІЛЬНІШИМ (виміряно: 7.7 с -> 8.3 с з --jobs 4).
$jobs = 1;
if ($values['--jobs'] === 'auto') {
    $jobs = ParallelRunner::cpuCount();
} elseif ($values['--jobs'] !== null) {
    if (!ctype_digit($values['--jobs']) || (int) $values['--jobs'] < 1) {
        fwrite(STDERR, "--jobs очікує ціле число >= 1 або auto.\n");
        exit(2);
    }
    $jobs = (int) $values['--jobs'];
}
if ($path === null) {
    fwrite(STDERR, "Не вказано шлях для аналізу.\n");
    exit(2);
}
$reportFormat = $values['--format'] ?? 'text';
if ($report && !in_array($reportFormat, ['text', 'json', 'html'], true)) {
    fwrite(STDERR, "--format очікує text, json або html.\n");
    exit(2);
}
if (!$report && ($values['--format'] !== null || $values['--output'] !== null)) {
    fwrite(STDERR, "--format і --output - опції 'anylint report'.\n");
    exit(2);
}
if ($report && ($fix || $generateBaseline || $values['--baseline'] !== null || $json || $checkstyle || $sarif)) {
    fwrite(STDERR, "'anylint report' не поєднується з --fix, --baseline, --generate-baseline, --json, --checkstyle, --sarif.\n");
    exit(2);
}

$analyzer = (new Analyzer())
    ->withJobs($jobs)
    ->withProvider(new PhpProvider())
    // NX_EXE - шлях до бінарника Nx, якщо він не в PATH під іменем "nx"
    // (типово при локальній збірці з вихідників, а не встановленого CLI).
    ->withProvider(new NyxilumProvider(getenv('NX_EXE') ?: 'nx'))
    // NODE_EXE - шлях до бінарника Node.js, якщо він не в PATH під іменем
    // "node". Обидва провайдери шлють файл в один і той самий
    // tools/js-ast-dump/dump.js (TypeScript compiler API парсить і .js, і
    // .ts - allowJs лише про перевірку типів, парсер спільний).
    ->withProvider(new JavaScriptProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new TypeScriptProvider(getenv('NODE_EXE') ?: 'node'))
    // Родина C-подібних мов - один движок tree-sitter (tools/treesitter-
    // ast-dump/dump.js), кожен провайдер лише передає свою мову як
    // аргумент і має власне supports() за розширенням файлу.
    ->withProvider(new CProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new CppProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new CSharpProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new JavaProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new PythonProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new RustProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new SwiftProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new GoProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new KotlinProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new LuaProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new RubyProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new DartProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new ZigProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new ObjectiveCProvider(getenv('NODE_EXE') ?: 'node'))
    ->withProvider(new SolidityProvider(getenv('NODE_EXE') ?: 'node'))
    ->withRule(new DeadCodeAfterReturnRule())
    ->withRule(new DeepNestingRule())
    ->withRule(new EmptyBlockRule())
    ->withRule(new EmptyCatchRule())
    ->withRule(new EmptyFunctionRule())
    ->withRule(new HardcodedSecretRule())
    ->withRule(new LongFunctionRule())
    ->withRule(new UnusedVariableRule())
    ->withRule(new PromotableReturnTypeRule())
    ->withRule(new WindowsScriptEncodingRule())
    ->withRule(new ComplexFunctionRule())
    ->withRule(new DuplicateCodeRule());

if (!$noTodo) {
    $analyzer->withRule(new TodoTrackerRule());
}

try {
    $config = match (true) {
        $configFile !== null => Config::fromFile($configFile),
        $noConfig => null,
        default => Config::discover($path),
    };
    if ($config !== null) {
        $analyzer->withConfig($config);
    }
    if (!$noCache) {
        $analyzer->withCache(ResultCache::defaultFile($path));
    }
    if ($report) {
        $data = ProjectReport::build($analyzer->analyze($path), $path);
        $output = match ($reportFormat) {
            'json' => json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE) . "\n",
            'html' => HtmlReport::render($data, realpath($path) ?: $path),
            default => TextReport::render($data),
        };
        if ($values['--output'] === null) {
            echo $output;
        } elseif (@file_put_contents($values['--output'], $output) === false) {
            throw new \RuntimeException("Не вдалось записати звіт у {$values['--output']}.");
        } else {
            fwrite(STDERR, "Звіт записано: {$values['--output']}\n");
        }
        // Звіт - не перевірка: успішно побудований звіт завжди exit 0.
        exit(0);
    }

    $findings = $analyzer->analyzePath($path);

    if ($fix) {
        // Повідомлення - у stderr, щоб не зламати --json/--sarif у stdout.
        // Після правок аналізуємо ще раз: зсуви інших знахідок уже не ті, а
        // показати треба саме те, що лишилось.
        $fixed = Fixer::apply($findings);
        fwrite(STDERR, "Виправлено автоматично: {$fixed}\n");
        if ($fixed > 0) {
            $findings = $analyzer->analyzePath($path);
        }
    }

    $baselineFile = $values['--baseline'] ?? $config?->baseline;
    if ($generateBaseline) {
        $baselineFile ??= ($config !== null ? $config->baseDir : (getcwd() ?: ".")) . DIRECTORY_SEPARATOR . 'anylint-baseline.json';
        $baseline = Baseline::fromFindings($findings, dirname($baselineFile));
        $baseline->save($baselineFile);
        fwrite(STDERR, "Baseline записано: {$baselineFile} ({$baseline->count()} знахідок)\n");
        exit(0);
    }
    if ($baselineFile !== null) {
        // Baseline з конфігу, якого ще не створено, - не помилка: проєкт
        // міг прописати шлях наперед, а --generate-baseline ще не запускали.
        if ($values['--baseline'] !== null || is_file($baselineFile)) {
            $findings = Baseline::fromFile($baselineFile)->filter($findings);
        }
    }
} catch (\RuntimeException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(2);
}

if ($sarif) {
    echo SarifFormatter::format($findings, getcwd() ?: '.');
    exit($findings === [] ? 0 : 1);
}

if ($checkstyle) {
    echo CheckstyleFormatter::format($findings);
    exit($findings === [] ? 0 : 1);
}

if ($json) {
    echo json_encode([
        'ok' => $findings === [],
        'findings' => array_map(static fn (Finding $f) => [
            'file' => $f->file,
            'line' => $f->line,
            'rule' => $f->rule,
            'severity' => $f->severity->value,
            'message' => $f->message,
            'fix' => $f->fix,
        ], $findings),
    // JSON_INVALID_UTF8_SUBSTITUTE: без нього json_encode() МОВЧКИ повертає
    // false, якщо повідомлення будь-якої Finding (напр. текст TODO-коментаря
    // чи ім'я процесу) містить хоч один невалідний UTF-8 байт - --json тоді
    // друкує ПОРОЖНІЙ рядок з exit-кодом 1, а споживач (CI) отримує
    // "помилка є, але дані порожні" замість реального звіту.
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE) . "\n";
    exit($findings === [] ? 0 : 1);
}

foreach ($findings as $finding) {
    $icon = match ($finding->severity) {
        Severity::Error => '❌',
        Severity::Warning => '⚠️ ',
        Severity::Info => 'ℹ️ ',
    };
    echo "{$icon} {$finding->file}:{$finding->line} [{$finding->rule}] {$finding->message}\n";
}

if ($findings === []) {
    echo "Проблем не знайдено.\n";
    exit(0);
}

echo "\nЗнайдено: " . count($findings) . "\n";
// Exit 1 для БУДЬ-якої знахідки (Warning чи Error) — узгоджено з --json,
// де exit-код теж означає лише "findings !== []", без розрізнення severity.
// Раніше текстовий режим виходив 0 для суто Warning-знахідок (напр.
// empty-catch/dead-code-after-return/unused-variable) - CI-скрипт, що
// перевіряє $? після "php bin/anylint src" (саме так, як показано в
// README), пропускав реальні знахідки.
exit(1);
